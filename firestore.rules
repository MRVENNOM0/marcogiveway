rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { return isSignedIn() && (request.auth.token.email == 'qadeerahmed235x@gmail.com' && request.auth.token.email_verified == true); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Helpers
    function isValidGiveaway(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.slug is string && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9-]+$') &&
             data.redirectUrl is string && data.redirectUrl.size() <= 500 &&
             data.status in ['active', 'ended'];
    }

    function isValidEntry(data) {
      return data.giveawayId is string && isValidId(data.giveawayId) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 100 &&
             data.discordUsername is string && data.discordUsername.size() <= 100 &&
             data.joinedAt == request.time;
    }

    // 4. Collections
    
    // Giveaways
    match /giveaways/{giveawayId} {
      allow read: if true; // Public can see active giveaways
      allow create: if isAdmin() && isValidGiveaway(incoming()) && incoming().createdAt == request.time;
      allow update: if (isAdmin() && isValidGiveaway(incoming())) || (
        isSignedIn() &&
        incoming().entryCount == (existing().get('entryCount', 0) + 1) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['entryCount', 'updatedAt']) &&
        existsAfter(/databases/$(database)/documents/giveaways/$(giveawayId)/entries/$(request.auth.uid))
      );
      allow delete: if isAdmin();

      // Entries subcollection
      match /entries/{userId} {
        allow get: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
        allow list: if true;
        allow create: if isSignedIn() && request.auth.token.email_verified == true && request.auth.uid == userId && isValidEntry(incoming()) && incoming().userId == request.auth.uid;
        // No update/delete allowed for entries
      }
    }
  }
}
